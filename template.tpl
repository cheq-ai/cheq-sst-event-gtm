___TESTS___

scenarios:
- name: Pushes event to the SST SDK and calls gtmOnSuccess
  code: |-
    runCode(mockData);

    assertThat(queueName).isEqualTo('Bootstrapper.SST');
    assertThat(pushedEvents.length).isEqualTo(1);
    assertThat(pushedEvents[0].name).isEqualTo('test_event');
    assertThat(pushedEvents[0].data.foo).isEqualTo('bar');
    assertThat(pushedEvents[0].data.__timestamp).isEqualTo(1234567890);
    assertApi('setInWindow').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Fails when the event name resolves empty at runtime
  code: |-
    mockData.event_name = '';

    runCode(mockData);

    assertThat(pushedEvents.length).isEqualTo(0);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Send immediately sets batch to false on the event
  code: |-
    mockData.send_immediately = true;

    runCode(mockData);

    assertThat(pushedEvents[0].batch).isEqualTo(false);
    assertApi('gtmOnSuccess').wasCalled();
- name: Batch flag is omitted when Send immediately is unchecked
  code: |-
    runCode(mockData);

    assertThat(pushedEvents[0].batch).isUndefined();
    assertApi('gtmOnSuccess').wasCalled();
- name: Includes custom data and custom params and publish path when provided
  code: |-
    mockData.custom_data = [{key: 'cd_key', value: 'cd_value'}];
    mockData.custom_params = [{key: 'cw_test', value: 'cw_value'}];
    mockData.publish_path = 'my_publish_path';

    runCode(mockData);

    assertThat(pushedEvents[0].customData.cd_key).isEqualTo('cd_value');
    assertThat(pushedEvents[0].customParams.cw_test).isEqualTo('cw_value');
    assertThat(pushedEvents[0].publishPath).isEqualTo('my_publish_path');
    assertApi('gtmOnSuccess').wasCalled();
- name: Omits customData and customParams and publishPath when not provided
  code: |-
    mockData.custom_data = undefined;
    mockData.custom_params = undefined;

    runCode(mockData);

    assertThat(pushedEvents[0].customData).isUndefined();
    assertThat(pushedEvents[0].customParams).isUndefined();
    assertThat(pushedEvents[0].publishPath).isUndefined();
    assertApi('gtmOnSuccess').wasCalled();
- name: Rows with empty keys are ignored
  code: |-
    mockData.event_data = [{key: '', value: 'ignored'}, {key: 'kept', value: 'yes'}];

    runCode(mockData);

    assertThat(pushedEvents[0].data.kept).isEqualTo('yes');
    assertThat(Object.keys(pushedEvents[0].data).length).isEqualTo(2);
    assertApi('gtmOnSuccess').wasCalled();
- name: Keeps a __timestamp supplied in the event data
  code: |-
    mockData.event_data = [{key: '__timestamp', value: 42}];

    runCode(mockData);

    assertThat(pushedEvents[0].data.__timestamp).isEqualTo(42);
- name: Uses the Event Data Object with table rows taking precedence
  code: |-
    mockData.event_data_object = {currency: 'GBP', foo: 'from_object', items: [{id: 'a'}]};

    runCode(mockData);

    assertThat(pushedEvents[0].data.currency).isEqualTo('GBP');
    assertThat(pushedEvents[0].data.foo).isEqualTo('bar');
    assertThat(pushedEvents[0].data.items[0].id).isEqualTo('a');
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails when the Event Data Object is not an object
  code: |-
    mockData.event_data_object = 'not an object';

    runCode(mockData);

    assertThat(pushedEvents.length).isEqualTo(0);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  const Object = require('Object');

  const mockData = {
    event_name: 'test_event',
    event_data: [{key: 'foo', value: 'bar'}],
    custom_data: [],
    custom_params: []
  };

  let queueName;
  const pushedEvents = [];
  mock('createQueue', (name) => {
    queueName = name;
    return (item) => pushedEvents.push(item);
  });
  mock('getTimestampMillis', () => 1234567890);


