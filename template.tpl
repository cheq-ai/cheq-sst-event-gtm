___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const createQueue = require('createQueue');
const getTimestampMillis = require('getTimestampMillis');
const getType = require('getType');
const makeTableMap = require('makeTableMap');
const Object = require('Object');
const setInWindow = require('setInWindow');

if (!data.event_name) {
  return data.gtmOnFailure();
}

const event_data = {};
if (data.event_data_object !== undefined && data.event_data_object !== '') {
  if (getType(data.event_data_object) !== 'object') {
    return data.gtmOnFailure();
  }
  Object.keys(data.event_data_object).forEach(function(key) {
    event_data[key] = data.event_data_object[key];
  });
}
const event_rows = makeTableMap(data.event_data || [], 'key', 'value') || {};
Object.keys(event_rows).forEach(function(key) {
  event_data[key] = event_rows[key];
});
const custom_data = makeTableMap(data.custom_data || [], 'key', 'value') || {};
const custom_params = makeTableMap(data.custom_params || [], 'key', 'value') || {};
// Drop rows whose key resolved to an empty string at runtime.
Object.delete(event_data, '');
Object.delete(custom_data, '');
Object.delete(custom_params, '');
event_data.__timestamp = event_data.__timestamp || getTimestampMillis();

const sst_event = {};
sst_event.name = data.event_name;
sst_event.data = event_data;
if (Object.keys(custom_data).length > 0) sst_event.customData = custom_data;
if (Object.keys(custom_params).length > 0) sst_event.customParams = custom_params;
if (data.publish_path) sst_event.publishPath = data.publish_path;
if (data.send_immediately) sst_event.batch = false;

// Ensure the parent global exists (createQueue throws if the key's path is missing).
// overrideExisting is false: a live SDK's Bootstrapper object is never touched.
setInWindow('Bootstrapper', {}, false);
const sstPush = createQueue('Bootstrapper.SST');
sstPush(sst_event);
data.gtmOnSuccess();


